{
  "name": "awesome-agent-avatars",
  "version": "0.1.0",
  "description": "Bring your AI agent to life: one motion engine, 58 agent states, hot-swappable open-source avatar styles.",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/types/react.d.ts",
      "import": "./dist/react.js"
    },
    "./dicebear": {
      "types": "./dist/types/dicebear.d.ts",
      "import": "./dist/dicebear.js"
    },
    "./styles/micah": {
      "types": "./dist/types/styles/micah.d.ts",
      "import": "./dist/styles/micah.js"
    },
    "./styles/avataaars": {
      "types": "./dist/types/styles/avataaars.d.ts",
      "import": "./dist/styles/avataaars.js"
    },
    "./styles/gaze": {
      "types": "./dist/types/styles/gaze.d.ts",
      "import": "./dist/styles/gaze.js"
    },
    "./styles/nice": {
      "types": "./dist/types/styles/nice.d.ts",
      "import": "./dist/styles/nice.js"
    },
    "./styles/fluent": {
      "types": "./dist/types/styles/fluent.d.ts",
      "import": "./dist/styles/fluent.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "react": [
        "./dist/types/react.d.ts"
      ],
      "dicebear": [
        "./dist/types/dicebear.d.ts"
      ],
      "styles/*": [
        "./dist/types/styles/*.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "prepack": "node -e \"for (const f of ['LICENSE','THIRD_PARTY_NOTICES.md']) require('fs').copyFileSync('../../'+f, f)\""
  },
  "peerDependencies": {
    "@dicebear/core": ">=10.7.0",
    "@dicebear/styles": ">=10.6.0",
    "react": ">=18",
    "react-dom": ">=18",
    "react-nice-avatar": ">=1.5.0"
  },
  "peerDependenciesMeta": {
    "@dicebear/core": {
      "optional": true
    },
    "@dicebear/styles": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-nice-avatar": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ai-agent",
    "avatar",
    "animation",
    "mascot",
    "dicebear",
    "react",
    "tauri",
    "electron",
    "nextjs",
    "agent-ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stitchable-ai/awesome-agent-avatars.git",
    "directory": "packages/awesome-agent-avatars"
  },
  "homepage": "https://awesome-agent-avatars.stitchable.ai",
  "bugs": {
    "url": "https://github.com/Stitchable-ai/awesome-agent-avatars/issues"
  }
}
